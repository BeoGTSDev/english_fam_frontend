{
  "name": "english-fam-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"vite.config.ts\" \"vitest.config.ts\" \"tsconfig*.json\" \"package.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"vite.config.ts\" \"vitest.config.ts\" \"tsconfig*.json\" \"package.json\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.75.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  }
}
